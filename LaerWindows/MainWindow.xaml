<Window x:Class="Laer.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Laer" Width="1280" Height="820" MinWidth="860" MinHeight="580" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" PreviewKeyDown="OnKeyDown" SizeChanged="WindowSizeChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid x:Name="WindowRoot" Background="{DynamicResource Rail}">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Button x:Name="SidebarToggle" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Margin="48,0,0,0" Click="ToggleSidebarClick" ToolTip="Hide sidebar (Ctrl+Shift+S)" AutomationProperties.Name="Hide sidebar" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="NotificationButton" Style="{StaticResource IconButton}" Click="NotificationsClick" ToolTip="Notifications" AutomationProperties.Name="Notifications" Margin="0,0,16,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeClick" AutomationProperties.Name="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeClick" AutomationProperties.Name="Maximize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button x:Name="CloseWindowButton" Style="{StaticResource CaptionButton}" Click="CloseWindowClick" AutomationProperties.Name="Close window" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Margin="4,8,4,8">
    <StackPanel DockPanel.Dock="Bottom">
     <Button x:Name="SavedRail" Style="{StaticResource RailButton}" Tag="saved" Click="SectionClick" ToolTip="Saved" AutomationProperties.Name="Saved"/>
     <Button x:Name="RefreshRail" Style="{StaticResource RailButton}" Click="RefreshClick" ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh"/>
     <Button x:Name="AccountButton" Style="{StaticResource RailButton}" Click="AccountClick" ToolTip="Account" AutomationProperties.Name="Account"/>
     <TextBlock x:Name="AccountLabel" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel>
     <Button x:Name="SearchRail" Style="{StaticResource RailButton}" Click="SearchClick" ToolTip="Search (Ctrl+K)" AutomationProperties.Name="Search"/>
     <Button x:Name="HomeRail" Style="{StaticResource RailButton}" Click="HomeClick" ToolTip="Home" AutomationProperties.Name="Home"/>
     <Button x:Name="UpcomingRail" Style="{StaticResource RailButton}" Tag="upcoming" Click="SectionClick" ToolTip="Upcoming" AutomationProperties.Name="Upcoming"/>
     <Button x:Name="CalendarRail" Style="{StaticResource RailButton}" Tag="calendar" Click="SectionClick" ToolTip="Calendar" AutomationProperties.Name="Calendar"/>
     <Button x:Name="MessagesRail" Style="{StaticResource RailButton}" Tag="messages" Click="SectionClick" ToolTip="Messages" AutomationProperties.Name="Messages"/>
    </StackPanel>
   </DockPanel>
   <Grid x:Name="Shell" Grid.Column="1" Margin="0,0,6,6" SizeChanged="ShellSizeChanged" Background="{DynamicResource Stage}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="248"/><ColumnDefinition x:Name="ContentColumn" Width="*" MinWidth="260"/><ColumnDefinition x:Name="SplitterColumn" Width="0"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource Chrome}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CourseList" Margin="8,8,8,8" AutomationProperties.Name="Courses"/></ScrollViewer></Border>
    <DockPanel x:Name="ContentPanel" Grid.Column="1" Background="{DynamicResource Stage}">
     <StackPanel x:Name="ScreenHeader" DockPanel.Dock="Top" Margin="24,24,24,0">
      <DockPanel x:Name="HeaderBar" LastChildFill="True"><StackPanel x:Name="HeaderActions" Orientation="Horizontal" DockPanel.Dock="Right"/><TextBlock x:Name="PageTitle" Text="Home" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
      <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Visibility="Collapsed" Margin="0,12,0,0"/>
      <ContentControl x:Name="Busy" Visibility="Collapsed" Width="12" Height="12" HorizontalAlignment="Left" Margin="0,8,0,0" Template="{StaticResource Spinner}" AutomationProperties.Name="Refreshing"/>
      <WrapPanel x:Name="Tabs" Margin="-12,16,-12,0"/>
     </StackPanel>
     <Grid>
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageBody" Margin="24,24,24,8" MaxWidth="720" HorizontalAlignment="Left"/></ScrollViewer>
      <Grid x:Name="CalendarHost" Visibility="Collapsed" Margin="0,16,0,0"/>
      <ScrollViewer x:Name="ReaderHost" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ReaderBody" Margin="24,24,24,8" MaxWidth="720" HorizontalAlignment="Left"/></ScrollViewer>
      <Grid x:Name="MessagesHost" Visibility="Collapsed">
       <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="16,16,16,8"><StackPanel x:Name="MessageHeaderActions" Orientation="Horizontal" DockPanel.Dock="Right"/><TextBlock Text="Messages" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MessageThreads" Margin="4,0,4,8"/></ScrollViewer>
       </DockPanel>
       <Border Grid.Column="1" Background="{DynamicResource Line}"/>
       <DockPanel Grid.Column="2">
        <TextBlock x:Name="ConversationTitle" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="24,24,24,8"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MessageBody" Margin="24,8,24,24"/></ScrollViewer>
       </DockPanel>
      </Grid>
     </Grid>
    </DockPanel>
    <GridSplitter x:Name="ViewerSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="ViewerResized" AutomationProperties.Name="Resize file panel"/>
    <DockPanel Grid.Column="3" x:Name="ViewerPanel" Background="{DynamicResource ViewerPanel}">
     <Grid DockPanel.Dock="Top" Height="44" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="ViewerTabs" Orientation="Horizontal" VerticalAlignment="Center"/></ScrollViewer>
      <Button x:Name="ViewerMenuButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="ViewerMenuClick" ToolTip="File actions" AutomationProperties.Name="File actions"/>
      <Button x:Name="ViewerCloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="CloseDetailClick" ToolTip="Close" AutomationProperties.Name="Close viewer"/>
     </Grid>
     <Grid x:Name="ViewerContents"><ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ViewerDetail" Margin="24,12,24,24"/></ScrollViewer><TextBlock x:Name="DetailTitle" Visibility="Collapsed"/></Grid>
    </DockPanel>
   </Grid>
  </Grid>
  <Grid x:Name="WelcomeOverlay" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Stage}">
   <StackPanel Width="320" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
    <TextBlock Text="Choose your institution" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="The first part of the address you sign in at, such as school in school.itslearning.com." FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBox x:Name="InstitutionField" AutomationProperties.Name="Institution" KeyDown="InstitutionKeyDown" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal"><Button Content="Continue" Style="{StaticResource Primary}" Click="ContinueSignInClick"/><Button Content="Explore demo" Click="DemoClick" Margin="8,0,0,0"/></StackPanel>
    <TextBlock x:Name="WelcomeError" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="PaletteOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource Scrim}" MouseDown="PaletteBackdropClick">
   <Border Width="560" MaxHeight="520" CornerRadius="16" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource StrongLine}" BorderThickness="1" VerticalAlignment="Top" Margin="16,72,16,16" MouseDown="PaletteSurfaceClick">
    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="8" Opacity="0.25" Color="Black"/></Border.Effect>
    <DockPanel><StackPanel DockPanel.Dock="Top">
      <DockPanel Height="44" Margin="12,0"><ContentControl x:Name="PaletteSearchIcon" Width="16" Margin="0,0,8,0"/><TextBox x:Name="PaletteQuery" BorderThickness="0" Background="Transparent" FontSize="15" Padding="0" MinHeight="0" VerticalContentAlignment="Center" TextChanged="PaletteQueryChanged" PreviewKeyDown="PaletteKeyDown" AutomationProperties.Name="Search"/></DockPanel>
      <WrapPanel x:Name="PaletteFilters" Margin="12,0,12,8"/><Border Height="1" Background="{DynamicResource Line}"/>
     </StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8"><TextBlock Text="↑ ↓ Navigate     Enter Open     Esc Close" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel><ListBox x:Name="PaletteResults" Margin="4" MinHeight="80" MaxHeight="350" MouseDoubleClick="PalettePickClick" PreviewKeyDown="PaletteKeyDown" AutomationProperties.Name="Search results"/></DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
